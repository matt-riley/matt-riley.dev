---
import wallFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "../styles/fonts.css";
import "../styles/immersive.css";
import { site } from "../content/site";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonicalPath?: string;
  skipTarget?: string;
  skipLabel?: string;
}
const { title = "Please touch. — Matt Riley", description = site.description, noindex = false, canonicalPath = Astro.url.pathname, skipTarget = "collection-summary", skipLabel = "Skip to the collection" } = Astro.props;
const canonical = new URL(canonicalPath.replace(/^\/404\/?$/, "/404.html"), Astro.site);
const home = new URL("/", Astro.site).href;
const shareImage = new URL("/og.jpg", Astro.site);
const shareImageAlt = "A speckled ceramic toolbox with an orange handle in warm window light beside the words: Please touch. Matt Riley makes small useful things.";
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, name: site.title, url: home, description: site.description, inLanguage: "en-GB", publisher: { "@id": `${home}#person` } },
    { "@type": "Person", "@id": `${home}#person`, name: "Matt Riley", url: home, sameAs: ["https://github.com/matt-riley", "https://mattriley.tools/"], homeLocation: { "@type": "Place", name: "Yorkshire" } },
  ],
}).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ead8c4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preload" href={wallFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    {!noindex && canonicalPath === "/" && <script type="application/ld+json" is:inline set:html={structuredData} />}
    <title>{title}</title>
  </head>
  <body class="immersive-page">
    <a class="immersive-skip" href={`#${skipTarget}`} data-open-toolbox={skipTarget === "collection-summary" || undefined}>{skipLabel}</a>
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="footer" />
  </body>
</html>
