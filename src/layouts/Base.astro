---
import wallFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import bodyItalic from "@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url";
import monoFont from "@fontsource/commit-mono/files/commit-mono-latin-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/catalogue.css";
import { site } from "../content/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/^\/404\/?$/, "/404.html"), Astro.site);
const shareImage = new URL("/og.png", Astro.site);
const home = new URL("/", Astro.site).href;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: site.title,
      url: home,
      description: site.description,
      inLanguage: "en-GB",
      publisher: { "@id": `${home}#person` },
    },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: "Matt Riley",
      url: home,
      sameAs: ["https://github.com/matt-riley", "https://mattriley.work/", "https://mattriley.tools/"],
      homeLocation: { "@type": "Place", name: "Yorkshire" },
    },
  ],
}).replace(/</g, "\\u003c");
const fontFaces = [
  ["Bricolage Grotesque Variable", wallFont, "normal", "200 800"],
  ["Newsreader Variable", bodyFont, "normal", "200 800"],
  ["Newsreader Variable", bodyItalic, "italic", "200 800"],
  ["Commit Mono", monoFont, "normal", "400"],
].map(([family, url, style, weight]) => `@font-face{font-family:"${family}";src:url("${url}") format("woff2");font-style:${style};font-weight:${weight};font-display:swap}`).join("");
---

<!doctype html>
<html lang="en-GB" data-lights="day" data-cat="on" data-sound="off" data-view="gallery">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preload" href={wallFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <script is:inline>(()=>{try{let d=document.documentElement;for(let[k,a,b,v]of[["lights","day","after-hours",matchMedia("(prefers-color-scheme: dark)").matches?"after-hours":"day"],["cat","on","off","on"],["sound","on","off","off"],["view","gallery","catalogue","gallery"]]){let s;try{s=localStorage.getItem("mr-"+k)}catch{}d.dataset[k]=s===a||s===b?s:v}let t=()=>d.querySelectorAll("meta[name=theme-color]").forEach(m=>m.content=d.dataset.lights==="after-hours"?"#0e0e10":"#f4f1ea");t();document.addEventListener("mr:setting",t)}catch{}})();</script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Please Touch: The Museum of Small Useful Things, by Matt Riley" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="Please Touch: The Museum of Small Useful Things, by Matt Riley" />
    {Astro.url.pathname === "/" && <script type="application/ld+json" is:inline set:html={structuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>
    {Astro.slots.has("header") && <header><slot name="header" /></header>}
    <main id="main" tabindex="-1"><slot name="main"><slot /></slot></main>
    {Astro.slots.has("footer") && <footer><slot name="footer" /></footer>}
    <script>
      import "../scripts/settings";
    </script>
  </body>
</html>
