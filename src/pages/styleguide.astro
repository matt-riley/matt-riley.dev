---
import Base from "../layouts/Base.astro";

const tokens = ["wall", "plinth", "ink", "ink-soft", "rule", "glaze", "glaze-ink"];
const fonts = [
  ["Wall", "var(--font-wall)"],
  ["Placard", "var(--font-body)"],
  ["Accession", "var(--font-mono)"],
];
const steps = ["wall", "title", "body", "meta"];
---

<Base title="Styleguide — Please Touch" description="Temporary design-system specimens for Please Touch." noindex>
  <p class="mono">Please Touch / foundation specimens</p>
  <h1>Small useful things.</h1>
  <p class="intro">Temporary styleguide. Saved lights settings apply before paint. Switch the browser’s colour preference or save mr-lights to inspect either mode.</p>
  <section aria-labelledby="palette-title">
    <h2 id="palette-title">The palette</h2>
    <ul class="palette">
      {tokens.map(token => <li><span class="swatch" style={`background:var(--${token})`} aria-hidden="true"></span><code>--{token}</code></li>)}
    </ul>
    <p class="mono soft">Glaze marks a part you can touch. Glaze ink is the colour for text.</p>
    <p class="mono glaze-ink">Please touch.</p>
  </section>
  <section aria-labelledby="type-title">
    <h2 id="type-title">The type</h2>
    {fonts.map(([label, family]) => <section class="specimen" aria-label={label}>
      <h3 class="mono">{label}</h3>
      {steps.map(step => <div class="type-row" style={`font-family:${family};font-size:var(--text-${step})`}>
        <span class="mono">{step}</span><p>Useful.</p>
      </div>)}
    </section>)}
    <p><em>A small useful thing, carefully labelled.</em></p>
  </section>
  <section aria-labelledby="controls-title">
    <h2 id="controls-title">Links and focus</h2>
    <p><a href="/">Return to the museum</a></p>
    <button type="button">Focus specimen</button>
    <hr />
    <p class="mono">MR.2026.001 / select this text</p>
  </section>
</Base>

<style>
  .intro { max-width: 40rem; }
  section { margin-block-start: var(--space-12); }
  section > * + * { margin-block-start: var(--space-6); }
  .palette { display: grid; grid-template-columns: repeat(auto-fit,minmax(8rem,1fr)); gap: var(--space-4); padding: 0; list-style: none; }
  .palette code { font-family: var(--font-mono); font-size: var(--text-meta); }
  .swatch { display: block; height: var(--space-24); border: 1px solid var(--rule); margin-block-end: var(--space-2); }
  .soft { color: var(--ink-soft); }
  .glaze-ink { color: var(--glaze-ink); background: var(--plinth); width: fit-content; padding: var(--space-2); }
  .specimen { border-block-start: 1px solid var(--rule); padding-block-start: var(--space-6); }
  .type-row { display: grid; grid-template-columns: 4rem minmax(0,1fr); align-items: center; gap: var(--space-4); line-height: 1.25; }
  .type-row p { max-width: none; margin: 0; white-space: nowrap; }
  @media (max-width: 40rem) { .type-row { grid-template-columns: 2.5rem minmax(0,1fr); gap: var(--space-2); } }
</style>
