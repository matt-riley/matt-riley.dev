---
import { getCollection, render } from "astro:content";
import Exhibit from "../components/Exhibit.astro";
import Header from "../components/Header.astro";
import MuseumFooter from "../components/MuseumFooter.astro";
import SplitFlap from "../components/SplitFlap.astro";
import { site } from "../content/site";
import { loadDossier } from "../data/github";
import Base from "../layouts/Base.astro";
import "../styles/exhibits.css";

const dossier = await loadDossier();
const entries = (await getCollection("exhibits")).sort((a, b) => a.data.order - b.data.order);
const exhibits = await Promise.all(entries.map(async (exhibit) => ({ exhibit, ...await render(exhibit) })));
---

<Base title={site.title} description={site.description}>
  <Header slot="header" />
  <div class="collection">
    {exhibits.map(({ exhibit, Content }) => (
      <Exhibit exhibit={exhibit} dossier={dossier}>
        <Content />
        {exhibit.data.id === "acquisitions" && <SplitFlap dossier={dossier} />}
      </Exhibit>
    ))}
  </div>
  <MuseumFooter slot="footer" dossier={dossier} />
</Base>

<script>
  import "../scripts/touch";
  import "../scripts/human-error";
  import "../scripts/gift-shop";
  import "../gallery/rail-entry";
  import "../scripts/gallery-gate";
  import "../scripts/gallery-interactions";
  import "../scripts/drawers";
</script>
