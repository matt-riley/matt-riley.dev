---
import { curatedCollection } from "../data/curated-collection";
import Base from "../layouts/BackMatterLayout.astro";

const stops = curatedCollection;
---

<Base title="Untitled (404) — Matt Riley" description="This exhibit is on loan." noindex>
  <div class="back-matter">
    <h1>This exhibit is on loan.</h1>
    <div class="loan-label">
      <p>Matt Riley, b. Yorkshire</p>
      <h2><em>Untitled (404)</em></h2>
      <p>2026 to ongoing</p>
      <p>A URL, misplaced</p>
      <p class="mono">MR.2026.404</p>
      <p>The label was here a moment ago. The cat has declined to comment.</p>
      <p><a href="/">Return to the museum</a></p>
    </div>
    <nav class="stop-menu" aria-label="The collection">
      <h2>The collection</h2>
      <ul>{stops.map((project, index) => <li><a href={`/#project-${project.id}`}><span class="mono">{String(index + 1).padStart(2, "0")}</span> {project.name}</a></li>)}</ul>
    </nav>
  </div>
</Base>
