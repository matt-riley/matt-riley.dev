---
import type { GitHubDossier } from "../data/types";

interface Props {
  dossier: GitHubDossier;
}

const { dossier } = Astro.props;
const { profile, totals, languages, activity } = dossier;
const sourceMark = dossier.source === "live" ? "LIVE PRESS" : "ARCHIVE PRINT";
const maxLanguage = Math.max(...languages.map((language) => language.count), 1);
const signalData = JSON.stringify(
  activity.map((event) => ({
    repo: event.repo,
    kind: event.kind,
    occurredAt: event.occurredAt,
  })),
);
const number = (value: number) => value.toLocaleString("en-GB");
---

<section
  class="signal-section press-section"
  id="work"
  aria-labelledby="dossier-title"
  data-story-section
>
  <div class="section-kicker dossier-kicker" data-reveal>
    <span>03 / PUBLIC RECORD</span>
    <span class="source-mark" aria-label={`GitHub data source: ${dossier.source}`}>
      {sourceMark}
    </span>
  </div>

  <div class="section-heading signal-heading" data-reveal>
    <div>
      <p class="eyebrow">The source is part of the story</p>
      <h2 id="dossier-title">The public<br />{" "}<span>trace.</span></h2>
    </div>
    <p class="section-heading__note">
      A build time snapshot of the work that is easiest to inspect: public repositories, public activity, no theatre.
    </p>
  </div>

  <div class="signal-layout">
    <div class="signal-profile" data-reveal>
      <figure class="signal-profile__portrait">
        <div class="portrait-frame">
          <div class="portrait-fallback" data-dossier-avatar-fallback aria-hidden="true">
            <span>MR</span>
            <small>PORTRAIT SIGNAL LOST</small>
          </div>
          <img
            src={profile.avatarUrl}
            alt={`GitHub avatar for ${profile.name}`}
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-dossier-avatar
          />
        </div>
        <figcaption>SUBJECT / {profile.login}</figcaption>
      </figure>
      <div class="signal-profile__copy">
        <p class="record-label">IDENTITY / VERIFIED BY PUBLIC OUTPUT</p>
        <a href={profile.profileUrl} class="profile-name">{profile.name}</a>
        <p>{profile.bio}</p>
        <span class="profile-location">{profile.location}</span>
      </div>
    </div>

    <div class="signal-record" data-reveal>
      <div class="signal-metrics" aria-label="GitHub summary">
        <div class="signal-metric">
          <strong>{number(totals.originalRepositories)}</strong>
          <span>original repositories</span>
        </div>
        <div class="signal-metric">
          <strong>{number(totals.stars)}</strong>
          <span>stars across the record</span>
        </div>
        <div class="signal-metric">
          <strong>{profile.accountAgeYears}y</strong>
          <span>account age</span>
        </div>
        <div class="signal-metric">
          <strong>{number(profile.followers)}</strong>
          <span>followers</span>
        </div>
      </div>

      <div
        class="signal-field"
        data-signal-field
        data-signal-data={signalData}
        data-signal-total={totals.originalRepositories}
      >
        <canvas data-signal-canvas aria-hidden="true"></canvas>
        <div class="signal-field__chrome" aria-hidden="true">
          <span>ACTIVITY / {String(activity.length).padStart(2, "0")} EVENTS</span>
          <span>BUILD TIME / {dossier.snapshotDate}</span>
        </div>
        <div class="signal-field__axis" aria-hidden="true">
          <span>00</span><span>25</span><span>50</span><span>75</span><span>100</span>
        </div>
        <p class="signal-field__caption">A quiet line through the public record.</p>
      </div>

      <div class="language-register">
        <div class="record-label">LANGUAGE IMPRESSIONS / TOP {String(languages.length).padStart(2, "0")}</div>
        <ol>
          {languages.map((language) => (
            <li>
              <span>{language.name}</span>
              <span class="language-track" aria-hidden="true">
                <span style={`--level:${(language.count / maxLanguage) * 100}%`}></span>
              </span>
              <b>{language.count}</b>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
