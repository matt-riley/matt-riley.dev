---
import { Picture } from "astro:assets";
import scene from "../assets/immersive/lore-scene.png";
import "../styles/immersive-lore.css";
---
<section id="lore-exhibit" class="lore-section" aria-labelledby="lore-heading">
  <div class="lore-art">
    <Picture src={scene} formats={["avif", "webp"]} fallbackFormat="jpeg" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 53vw" alt="An open speckled ceramic note box with an orange tab and blank paper cards, in warm window light." loading="lazy" />
  </div>
  <div class="lore-copy" data-lore-example>
    <h2 id="lore-heading">Lore<span>.</span></h2>
    <p class="lore-intro">Keep the decision. Find it again.</p>
    <div class="lore-original">
      <h3>Session one · supplied note</h3>
      <blockquote id="lore-original-note">We chose SQLite so this project can run without a separate database server.</blockquote>
      <p class="lore-provenance" id="lore-original-source">Source: supplied Session one note · Project: inventory</p>
    </div>
    <fieldset class="lore-questions" aria-describedby="lore-example-limit">
      <legend>Session two</legend>
      <button type="button" data-lore-question="database" aria-pressed="false" disabled>Which database did we choose?</button>
      <button type="button" data-lore-question="deployment" aria-pressed="false" disabled>How are we deploying it?</button>
    </fieldset>
    <div class="lore-answer" role="status" aria-atomic="true">
      <p data-lore-answer>Choose a question to recall the earlier note.</p>
      <p class="lore-provenance" data-lore-answer-source hidden>Source: supplied Session one note · Project: inventory</p>
    </div>
    <noscript><p class="lore-noscript">The supplied note records the database decision. It contains no deployment decision. Enable JavaScript to choose between these questions.</p></noscript>
    <a class="text-action lore-source-link" href="https://github.com/matt-riley/lore">View source<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></a>
    <p class="lore-limit" id="lore-example-limit">Illustration. Nothing is saved here, and no question is sent to a model.</p>
  </div>
</section>
