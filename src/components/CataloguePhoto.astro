---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { id: string; alt: string; entrance?: boolean }
const { id, alt, entrance = false } = Astro.props;
const originals = import.meta.glob<{ default: ImageMetadata }>("../assets/catalogue/*.png", { eager: true });
const widths = [640, 960, 1440, 2400];
const narrowColumn = ["flagz", "agent-skills", "acquisitions", "gift-shop"].includes(id);
const sizes = entrance
  ? "(min-width: 1312px) 1280px, calc(100vw - 32px)"
  : narrowColumn
    ? "(min-width: 1312px) 551px, (min-width: 900px) calc((100vw - 128px) * 0.465), calc(100vw - 32px)"
    : "(min-width: 1312px) 634px, (min-width: 900px) calc((100vw - 128px) * 0.535), calc(100vw - 32px)";

const photos = await Promise.all((["day", "night"] as const).map(async (mode) => {
  const source = (crop: string) => {
    const photo = originals[`../assets/catalogue/${id}-${mode}-${crop}.png`]?.default;
    if (!photo) throw new Error(`Missing catalogue photograph: ${id}-${mode}-${crop}.png. Run pnpm assets:stills.`);
    return photo;
  };
  const variants = await Promise.all((["square", "wide"] as const).flatMap((crop) =>
    (["avif", "webp"] as const).map(async (format) => {
      const src = source(crop);
      const images = await Promise.all(widths.filter((width) => width <= src.width).map((width) =>
        getImage({ src, width, format, quality: format === "avif" ? 48 : 70 })
      ));
      return { crop, format, srcset: images.map((image, index) => `${image.src} ${widths[index]}w`).join(", "), width: src.width, height: src.height };
    })
  ));
  const fallback = await getImage({ src: source("wide"), width: 960, format: "webp", quality: 70 });
  return { mode, variants, fallback };
}));
---

<div class="catalogue-photo">
  {photos.map(({ mode, variants, fallback }) => (
    <picture class={`catalogue-photo__${mode}`} data-photo-mode={mode}>
      {variants.map(({ crop, format, srcset, width, height }) => (
        <source media={crop === "square" ? "(max-width: 699px)" : "(min-width: 700px)"} type={`image/${format}`} srcset={srcset} sizes={sizes} width={width} height={height} />
      ))}
      <img src={fallback.src} alt={alt} width="2400" height="1600" loading="lazy" decoding="async" fetchpriority={entrance ? "high" : "auto"} />
    </picture>
  ))}
</div>

<style>
  .catalogue-photo { width: 100%; aspect-ratio: 3 / 2; background: var(--plinth); }
  picture, img { display: block; width: 100%; height: 100%; }
  img { object-fit: cover; }
  .catalogue-photo__night { display: none; }
  :global(:root[data-lights="after-hours"]) .catalogue-photo__day { display: none; }
  :global(:root[data-lights="after-hours"]) .catalogue-photo__night { display: block; }
  @media (max-width: 699px) { .catalogue-photo { aspect-ratio: 1; } }
</style>
