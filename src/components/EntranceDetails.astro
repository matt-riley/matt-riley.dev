---
import { openingHoursAt } from "../exhibits/opening-hours";
const built = openingHoursAt(new Date());
---
<p class="opening-hours mono" data-opening-hours data-built-hours={built.text}>Open most hours. Yorkshire time.</p>
<a class="entrance-cue mono" href="#tools" data-scroll-cue>Come in<span aria-hidden="true"></span></a>
<script>
  import "../exhibits/entrance";
</script>
<style>
  :global(.entrance-line:nth-child(1)) { --line: 0; }
  :global(.entrance-line:nth-child(2)) { --line: 1; }
  :global(.entrance-line:nth-child(3)) { --line: 2; }
  :global(#entrance-heading .entrance-line) { display: block; }
  :global(.gallery-wall-title:has(.entrance-line)) { display: flex; flex-direction: column; justify-content: center; gap: .1em; }
  :global(.gallery-wall-title .entrance-line) { display: block; }
  :global(.gallery-opening-hours) { font-size: clamp(8px, .3em, 14px); line-height: 1.3; letter-spacing: 0; font-weight: 400; }
  .opening-hours { margin-block: var(--space-4); }
  .entrance-cue { position: fixed; inset-block-end: 1rem; inset-inline-start: 50%; translate: -50% 0; z-index: 2; display: grid; justify-items: center; gap: .5rem; color: var(--ink); font-size: .65rem; text-decoration: none; }
  .entrance-cue span { width: 1px; height: 1.25rem; background: currentColor; }
  .entrance-cue[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-entrance-arrival] .entrance-line) { animation: entrance-arrival .4s both; animation-delay: calc(var(--line) * 60ms); }
    @keyframes entrance-arrival { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  }
</style>
